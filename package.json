{
  "name": "hourglass-timer",
  "version": "0.0.1",
  "description": "A cross-platform progressive desktop timer with hourglass animation and system tray support",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable --dir",
    "dist": "electron-builder --win portable"
  },
  "keywords": [
    "timer",
    "hourglass",
    "pomodoro",
    "electron",
    "tray"
  ],
  "author": "Abir",
  "license": "MIT",
  "build": {
    "appId": "com.hourglass.timer",
    "productName": "Hourglass Timer",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    },
    "portable": {
      "artifactName": "Hourglass-Timer-v0.0.1.exe"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "renderer.js",
      "icon.ico"
    ]
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
