{
  "name": "hourglass-timer",
  "version": "0.0.1",
  "description": "A cross-platform progressive desktop timer with hourglass animation and system tray support",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --ia32"
  },
  "keywords": [
    "timer",
    "hourglass",
    "pomodoro",
    "electron",
    "tray"
  ],
  "author": "Abir",
  "license": "MIT",
  "build": {
    "appId": "com.hourglass.timer",
    "productName": "Hourglass Timer",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hourglass Timer",
      "artifactName": "Hourglass-Timer-Setup-v0.0.1-${arch}.exe"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "renderer.js",
      "icon.ico"
    ]
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
